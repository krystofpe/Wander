{
  "name": "wander",
  "version": "0.3.0",
  "description": "A lone wanderer walks forever through procedurally generated pixel-art lands, in the browser",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test",
    "shot": "node --disable-warning=ExperimentalWarning tools/shot.ts",
    "sheet": "node --disable-warning=ExperimentalWarning tools/sheet.ts",
    "art": "node --disable-warning=ExperimentalWarning tools/art/export.ts",
    "art:draw": "node --disable-warning=ExperimentalWarning tools/art/draw.ts",
    "motion": "node --disable-warning=ExperimentalWarning tools/motion.ts",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "creature": "node --disable-warning=ExperimentalWarning server/main.ts --creature",
    "creature:tour": "node --disable-warning=ExperimentalWarning tools/creature-tour.ts",
    "creature:check": "node --disable-warning=ExperimentalWarning tools/creature-check.ts",
    "wisp:check": "node --disable-warning=ExperimentalWarning tools/wisp-check.ts",
    "listen": "node --disable-warning=ExperimentalWarning tools/listen.ts",
    "watch": "node --disable-warning=ExperimentalWarning tools/watch.ts",
    "tour": "node --disable-warning=ExperimentalWarning tools/tour.ts",
    "bench": "node --disable-warning=ExperimentalWarning tools/bench.ts",
    "soak": "node --disable-warning=ExperimentalWarning tools/soak.ts",
    "check": "node --disable-warning=ExperimentalWarning tools/check.ts",
    "live": "node --disable-warning=ExperimentalWarning tools/live.ts",
    "site": "node --disable-warning=ExperimentalWarning tools/site.ts",
    "site:check": "node --disable-warning=ExperimentalWarning tools/site-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.132.1"
  },
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}
